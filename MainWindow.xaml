<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TagLinx._01._00.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TagLinx._01._00"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:UserControls="using:TagLinx._01._00.Controls"
    xmlns:ToolBox="using:TagLinx._01._00.Controls.ToolBox"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    Title="TagLinx.01.00">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="MainGrid" 
          Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--１行目-->
        <Border BorderBrush="Gray"
                BorderThickness="0,0,0,1">

        </Border>
        


        <!--２行目-->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>
            <!--ナビゲーション-->
            <Border Grid.Column="0" 
                    BorderBrush="Gray" 
                    BorderThickness="0,0,0,1">
                <UserControls:Navigation />
            </Border>
            <!--アドレスバー-->
            <Border Grid.Column="1" 
                    BorderBrush="Gray" 
                    BorderThickness="0,0,0,1">
                <Grid>
                    <UserControls:AddressBar x:Name="AddressBar"/>
                    <UserControls:BreadcrumbAddressBar x:Name="BreadcrumbAddressBar" 
                                                       CurrentPath="{Binding CurrentPath, ElementName=AddressBar, Mode=TwoWay}"/>
                </Grid>
            </Border>
            <!--検索バー-->
            <Border Grid.Column="2" 
                    BorderBrush="Gray" 
                    BorderThickness="0,0,0,1">
                <AutoSuggestBox PlaceholderText="検索" QueryIcon="Find" 
                                HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="5"/>
            </Border>
        </Grid>

        
        
        <!--３行目-->
        <Grid Grid.Row="2">
            <!--ツールボックス-->
            <Border BorderBrush="Gray" 
                    BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="5">
                    <ToolBox:NewCreate/>

                    <AppBarSeparator Height="40" HorizontalAlignment="Center"/>
                    
                    <ToolBox:Cut/>
                    <ToolBox:Copy/>
                    <ToolBox:Paste/>
                    <ToolBox:Rename/>
                    <ToolBox:Share/>
                    <ToolBox:Delete/>

                    <AppBarSeparator Height="40" HorizontalAlignment="Center"/>
                    
                    <ToolBox:Sort/>
                    <ToolBox:Display/>

                    <AppBarSeparator Height="40" HorizontalAlignment="Center"/>
                    
                    <ToolBox:Macro/>
                    <ToolBox:Option/>
                </StackPanel>
            </Border>
        </Grid>

            
            
        <!--４行目-->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="QuickAccessZone"
                                  MinWidth="100" MaxWidth="300" Width="200"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="WorkSpaceZone"
                                  MinWidth="100" MaxWidth="300" Width="200"/>
            </Grid.ColumnDefinitions>
            <!--１列目(QuickAccessZone)-->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
            </Grid>
            <!--２列目(DirectoryList)-->
            <Border Grid.Column="1" 
                    BorderBrush="Gray" 
                    BorderThickness="1,0,1,0">
                <UserControls:FileList x:Name="FileList"
                                       CurrentPath="{Binding CurrentPath, ElementName=AddressBar, Mode=TwoWay}"/>
            </Border>
            <!--３列目-->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
            </Grid>
            <!-- Splitter -->
            <controls:GridSplitter Grid.Column="1"
                                   Width="16"
                                   HorizontalAlignment="Left"
                                   ResizeBehavior="BasedOnAlignment"
                                   ResizeDirection="Auto"
                                   Background="Transparent">
                <controls:GridSplitter.RenderTransform>
                    <TranslateTransform X="-7.5"/>
                </controls:GridSplitter.RenderTransform>
            </controls:GridSplitter>
            <controls:GridSplitter Grid.Column="1"
                                   Width="16"
                                   HorizontalAlignment="Right"
                                   ResizeBehavior="BasedOnAlignment"
                                   ResizeDirection="Auto"
                                   Background="Transparent">
                <controls:GridSplitter.RenderTransform>
                    <TranslateTransform X="7.5"/>
                </controls:GridSplitter.RenderTransform>
            </controls:GridSplitter>
        </Grid>
    </Grid>
</Window>
