<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TagLinx._01._00.Controls.AddressBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TagLinx._01._00.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid>
        <AutoSuggestBox x:Name="AddressBar_AutoSuggestBox"
                        Margin="5"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        PlaceholderText="パスを入力..."
                        TextChanged="AddressBar_AutoSuggestBox_TextChanged"
                        KeyDown="AddressBar_AutoSuggestBox_KeyDown"
                        SuggestionChosen="AddressBar_AutoSuggestBox_SuggestionChosen"/>
    </Grid>
</UserControl>
