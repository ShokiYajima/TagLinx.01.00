<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TagLinx._01._00.Controls.AddressBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TagLinx._01._00.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Name="Root">
    <!--<Grid>-->
    <AutoSuggestBox x:Name="AddressBar_AutoSuggestBox"
                        Margin="5" Foreground="Transparent"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Text="{Binding CurrentPath, ElementName=Root, Mode=OneWay}"
                        GettingFocus="AddressBar_AutoSuggestBox_GettingFocus"
                        GotFocus="AddressBar_AutoSuggestBox_GotFocus"
                        LostFocus="AddressBar_AutoSuggestBox_LostFocus"
                        TextChanged="AddressBar_AutoSuggestBox_TextChanged"
                        SuggestionChosen="AddressBar_AutoSuggestBox_SuggestionChosen"
                        QuerySubmitted="AddressBar_AutoSuggestBox_QuerySubmitted">
        <AutoSuggestBox.Resources>
            <SolidColorBrush x:Key="TextControlForegroundPointerOver"
                             Color="Transparent"/>
        </AutoSuggestBox.Resources>
    </AutoSuggestBox>
        <!--</Grid>-->
</UserControl>
