<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TagLinx._01._00.Controls.FileList"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TagLinx._01._00.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--************************************************************-->
        <!-- Header                                                     -->
        <!--************************************************************-->
        <!--詳細-->
        <DataTemplate x:Key="Header_Detail">
            <Grid ColumnSpacing="10" Height="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="名前" FontWeight="Bold"/>
                <TextBlock Grid.Column="1" Text="更新日時" FontWeight="Bold"/>
                <TextBlock Grid.Column="2" Text="種類" FontWeight="Bold"/>
                <TextBlock Grid.Column="3" Text="サイズ" FontWeight="Bold"/>
                <TextBlock Grid.Column="4" Text="タグ" FontWeight="Bold"/>
                <TextBlock Grid.Column="5" Text="コメント" FontWeight="Bold"/>
            </Grid>
        </DataTemplate>
        <!--その他-->
        <DataTemplate x:Key="Header_Other"/>
        
        <!--************************************************************-->
        <!-- Item                                                       -->
        <!--************************************************************-->
        <!--詳細-->
        <DataTemplate x:Key="Item_Detail">
            <Grid ColumnSpacing="10" Height="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <Image x:Name="Image_TextBlock"  Source="{Binding Icon}"
                           Width="16" Height="16"
                           HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <TextBlock x:Name="Name_TextBlock" Text="{Binding Name}"
                               HorizontalAlignment="Left" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="WriteTime_TextBlock" Text="{Binding WriteTimeText}" 
                           HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" x:Name="Type_TextBlock" Text="{Binding Type}" 
                           HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" x:Name="Size_TextBlock" Text="{Binding SizeText}" 
                           HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="4" x:Name="Tag_TextBlock" Text="{Binding Tag}" 
                           HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="5" x:Name="Comment_TextBlock" Text="{Binding Comment}" 
                           HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
        <!--一覧-->
        <DataTemplate x:Key="Item_List">
            <Grid ColumnSpacing="10" Height="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <Image x:Name="Image_TextBlock"  Source="{Binding Icon}"
                           Width="16" Height="16"
                           HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <TextBlock x:Name="Name_TextBlock" Text="{Binding Name}"
                               HorizontalAlignment="Left" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <!--************************************************************-->
    <!-- 本体                                                       -->
    <!--************************************************************-->
    <Grid>
        <ListView x:Name="FileListView"
                  HeaderTemplate="{StaticResource Header_Detail}"
                  ItemTemplate="{StaticResource Item_Detail}"
                  IsItemClickEnabled="True"
                  ItemClick="FileListView_ItemClick"
                  SelectionMode="Extended"/>
    </Grid>
</UserControl>
