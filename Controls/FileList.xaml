<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TagLinx._01._00.Controls.FileList"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TagLinx._01._00.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ListView x:Name="FileListView"
                  IsItemClickEnabled="True"
                  ItemClick="FileListView_ItemClick"
                  SelectionMode="Extended">
            <!--ヘッダ-->
            <ListView.Header>
                <Grid ColumnSpacing="10" Height="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="名前" FontWeight="Bold"/>
                    <TextBlock Grid.Column="1" Text="更新日時" FontWeight="Bold"/>
                    <TextBlock Grid.Column="2" Text="種類" FontWeight="Bold"/>
                    <TextBlock Grid.Column="3" Text="サイズ" FontWeight="Bold"/>
                    <TextBlock Grid.Column="4" Text="タグ" FontWeight="Bold"/>
                    <TextBlock Grid.Column="5" Text="コメント" FontWeight="Bold"/>
                </Grid>
            </ListView.Header>
            <!--ファイルリスト-->
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnSpacing="10" Height="32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                            <!--アイコン-->
                            <Image x:Name="Image_TextBlock" 
                                   Source="{Binding Icon}"
                                   VerticalAlignment="Center"/>
                            <!--名前-->
                            <TextBlock x:Name="Name_TextBlock" 
                                       Text="{Binding Name}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <!--更新日時-->
                        <TextBlock Grid.Column="1" 
                                   x:Name="WriteTime_TextBlock" 
                                   Text="{Binding WriteTimeText}" 
                                   VerticalAlignment="Center"/>
                        <!--種類-->
                        <TextBlock Grid.Column="2" 
                                   x:Name="Type_TextBlock" 
                                   Text="{Binding Type}" 
                                   VerticalAlignment="Center"/>
                        <!--サイズ-->
                        <TextBlock Grid.Column="3" 
                                   x:Name="Size_TextBlock" 
                                   Text="{Binding SizeText}" 
                                   VerticalAlignment="Center"/>
                        <!--タグ-->
                        <TextBlock Grid.Column="4" 
                                   x:Name="Tag_TextBlock" 
                                   Text="{Binding Tag}" 
                                   VerticalAlignment="Center"/>
                        <!--コメント-->
                        <TextBlock Grid.Column="5" 
                                   x:Name="Comment_TextBlock" 
                                   Text="{Binding Comment}" 
                                   VerticalAlignment="Center"/>

                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
